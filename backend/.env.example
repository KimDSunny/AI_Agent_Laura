APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Supabase 대시보드에서 프로젝트를 만든 뒤 입력해.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# 관리자 권한 키는 FastAPI 서버에서만 사용하고 React에는 절대 넣지 마.
SUPABASE_SECRET_KEY=

# Google Cloud Console에서 Calendar API를 켠 뒤 웹 애플리케이션 OAuth 키를 입력해.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/integrations/google-calendar/callback
GOOGLE_OAUTH_STATE_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=
FRONTEND_URL=http://127.0.0.1:5173
# OpenAI Responses API (Phase 4 agent)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
